server {
    listen 3000; # TODO: env

    # uncomment when using ssl
    # listen 3000 ssl;
    # ssl_certificate /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # keep the trailing slash for both 'location' and 'proxy_path' to strip "/api" from proxy path
    location /api/ { # TODO: env
        proxy_pass http://host.docker.internal:4001/; # TODO: use env var

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { # TODO: env
        proxy_pass http://host.docker.internal:3001; # TODO: use env var

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
